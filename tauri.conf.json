{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDex",
  "version": "1.0.0",
  "identifier": "org.opendex.desktop",
  "build": {
    "frontendDist": [
      "ui/index.html",
      "ui/style.css",
      "ui/app.js",
      "ui/history-search.js",
      "ui/dom.js",
      "ui/icons.js",
      "ui/settings.js",
      "ui/backup-settings.js",
      "ui/mcp-context.js",
      "ui/voice.js",
      "ui/image-settings.js",
      "ui/dictation.js"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenDex",
        "width": 1220,
        "height": 800,
        "minWidth": 670,
        "minHeight": 540,
        "backgroundColor": "#141619"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "main",
          "description": "OpenDex main window can subscribe to events and open native file dialogs.",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:default",
            "dialog:allow-open",
            "dialog:allow-save"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "infoPlist": "macos/Info.plist"
    }
  }
}
